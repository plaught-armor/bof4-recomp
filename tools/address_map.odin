// Build docs/address-map.md from the port's named constants.
//
// Every top-level Odin constant in port/src whose value is a PS1 RAM or
// scratchpad address (`NAME :: 0x8xxxxxxx` or `0x1f80xxxx`) is listed,
// sorted by address, with the comment on its line and the comment block
// just above it, and the file and line it comes from. Constants naming the
// same address in several files are merged into one row. A per-overlay
// enumerated array (`NAME := [Setting_Overlay]u32{.Camp = 0x8..., .Title =
// 0x8...}`) lists each element as `NAME[.Camp]`, `NAME[.Title]`.
package tools

import "core:fmt"
import "core:path/filepath"
import "core:slice"
import "core:strings"
import "core:text/regex"

ADDRESS_MAP_USAGE :: `Usage (from the repo root):
  bof4tools address-map port/src docs/address-map.md`

CONST_RE :: `^([A-Z][A-Z0-9_]*)\s*::\s*(0x[0-9a-fA-F]{8})\b\s*(?://\s*(.*))?$`
ARRAY_RE :: `^([A-Z][A-Z0-9_]*)\s*:[:=]\s*\[[A-Za-z_]+\][a-z0-9]+\{([^}]*)\}\s*(?://\s*(.*))?$`
ELEM_RE :: `\.([A-Za-z_]+)\s*=\s*(0x[0-9a-fA-F]{8})\b`

Address_Use :: struct {
	name: string,
	file: string,
	line: int,
	note: string,
}

address_region :: proc(addr: u32) -> string {
	switch addr {
	case 0x1F800000 ..< 0x1F800400:
		return "Scratchpad (0x1f800000-0x1f8003ff)"
	case 0x80000000 ..< 0x80010000:
		return "Kernel area (0x80000000-0x8000ffff)"
	case 0x80010000 ..< 0x80180000:
		return "Executable SLUS_013.24 code and data (0x80010000-0x8017ffff)"
	case 0x80180000 ..< 0x80200000:
		return "Overlay area and heap (0x80180000-0x801fffff)"
	}
	return ""
}

compile :: proc(pattern: string) -> regex.Regular_Expression {
	re, err := regex.create(pattern)
	if err != nil {
		fail("regex %s: %v", pattern, err)
	}
	return re
}

group :: proc(c: regex.Capture, i: int) -> string {
	return i < len(c.groups) ? c.groups[i] : ""
}

address_scan :: proc(root: string) -> map[u32][dynamic]Address_Use {
	const_re, array_re, elem_re := compile(CONST_RE), compile(ARRAY_RE), compile(ELEM_RE)
	rows: map[u32][dynamic]Address_Use
	clean, _ := filepath.clean(root)
	top := filepath.base(clean)
	for rel in walk_sorted(root) {
		if !strings.has_suffix(rel, ".odin") || strings.contains(concat("/", rel), "/rec/") {
			continue
		}
		lines := strings.split(string(read_file(join(root, rel))), "\n")
		for line, i in lines {
			Found :: struct {
				name: string,
				addr: u32,
			}
			found: [dynamic]Found
			m, ok := regex.match(const_re, line)
			if ok {
				append(&found, Found{group(m, 1), parse_hex(group(m, 2))})
			} else {
				m, ok = regex.match(array_re, line)
				if !ok {
					continue
				}
				body := group(m, 2)
				for {
					e, e_ok := regex.match(elem_re, body)
					if !e_ok {
						break
					}
					append(&found, Found{fmt.aprintf("%s[.%s]", group(m, 1), group(e, 1)), parse_hex(group(e, 2))})
					body = body[e.pos[0][1]:]
				}
			}
			kept := slice.filter(found[:], proc(f: Found) -> bool {
				return address_region(f.addr) != ""
			})
			if len(kept) == 0 {
				continue
			}
			above: [dynamic]string
			j := i - 1
			for j >= 0 && strings.has_prefix(strings.trim_space(lines[j]), "@(") {
				j -= 1
			}
			for j >= 0 && strings.has_prefix(lines[j], "//") {
				inject_at(&above, 0, strings.trim_space(lines[j][2:]))
				j -= 1
			}
			parts: [dynamic]string
			if a := strings.join(above[:], " "); a != "" {
				append(&parts, a)
			}
			if c := group(m, 3); c != "" {
				append(&parts, c)
			}
			note := strings.trim_space(strings.join(parts[:], " "))
			for f in kept {
				uses := rows[f.addr]
				append(&uses, Address_Use{f.name, concat(top, "/", rel), i + 1, note})
				rows[f.addr] = uses
			}
		}
	}
	return rows
}

table_cell :: proc(text: string) -> string {
	s, _ := strings.replace_all(text, "|", "\\|")
	s, _ = strings.replace_all(s, "\n", " ")
	return s
}

address_map_main :: proc(args: []string) {
	usage(args, ADDRESS_MAP_USAGE, 2)
	rows := address_scan(args[0])
	addrs, _ := slice.map_keys(rows)
	slice.sort(addrs)
	// Regions in address order: each region's addresses are contiguous.
	b := strings.builder_make()
	fmt.sbprintf(&b, `# Address map

Generated by ` + "`bof4tools address-map`" + ` from the named constants in ` + "`port/src`" + `;
do not edit by hand. Every address here is one the port reads, writes, hooks
or calls, named and described where it is used. Overlay addresses are only
valid while that overlay is loaded (see [overlays.md](overlays.md)).

%d addresses.
`, len(rows))
	region := ""
	for addr in addrs {
		if r := address_region(addr); r != region {
			region = r
			fmt.sbprintf(&b, "\n## %s\n\n| Address | Name | Notes | Source |\n|---|---|---|---|\n", r)
		}
		uses := rows[addr]
		names: [dynamic]string
		notes: [dynamic]string
		srcs: [dynamic]string
		for u in uses {
			if !slice.contains(names[:], u.name) {
				append(&names, u.name)
			}
			if u.note != "" && !slice.contains(notes[:], u.note) {
				append(&notes, u.note)
			}
			append(&srcs, fmt.aprintf("`%s:%d`", u.file, u.line))
		}
		slice.sort(names[:])
		fmt.sbprintf(&b, "| `%08x` | %s | %s | %s |\n", addr, table_cell(strings.join(names[:], ", ")), table_cell(strings.join(notes[:], " / ")), strings.join(srcs[:], "<br>"))
	}
	write_file(args[1], b.buf[:])
	print("%d addresses -> %s", len(rows), args[1])
}
