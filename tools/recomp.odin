// Static recompiler: MIPS R3000A machine code -> Odin source.
//
// Each recompiled function becomes an Odin procedure that operates on the
// emulated CPU state (`psx.cpu`) and memory bus (`psx.lw`, `psx.sw`, ...).
// Control flow inside a function is a `for { switch pc { ... } }` state
// machine whose cases are basic-block labels; straight-line code falls
// through. Calls go through `psx.call(addr)` so the runtime can pick overlay
// variants, apply hand-written overrides and fall back to its interpreter.
//
// Both modes read the executable and every overlay: functions reached only
// through pointers are found from references anywhere in the program.
package tools

import "core:crypto/legacy/sha1"
import "core:fmt"
import "core:slice"
import "core:strings"

RECOMP_USAGE :: `Usage: bof4tools recomp exe|ovl <SLUS_013.24> <overlays dir> <funcs.tsv> <out dir>
  exe  writes <out dir>/exe.odin
  ovl  writes <out dir>/ovl_NN/funcs.odin and <out dir>/overlays.odin`

// Average R3000A cost per instruction including memory stalls. Timing loops
// in the PsyQ libraries (VSync timeout, CD waits) assume roughly this.
CYCLES_PER_INSN :: 2

// Executable code range (PS-X EXE text; everything outside is data or
// overlay space).
EXE_CODE_LO :: 0x80139598
EXE_CODE_HI :: 0x80172BDC
// Main RAM in KSEG0, for pointer scans.
RAM_LO :: 0x80000000
RAM_HI :: 0x80200000

REC_HEADER :: "// Generated by bof4tools recomp. Do not edit."

Code_Image :: struct {
	base: u32,
	data: []u8,
}

@(private = "file")
word :: proc(img: Code_Image, addr: u32) -> (u32, bool) {
	o := i64(addr) - i64(img.base)
	if o < 0 || o + 4 > i64(len(img.data)) {
		return 0, false
	}
	return u32le(img.data, int(o)), true
}

@(private = "file")
sx16 :: proc(v: u32) -> i32 {
	return i32(i16(u16(v)))
}

@(private = "file")
hexu :: proc(v: u32) -> string {
	return fmt.aprintf("0x%08x", v)
}

// ---------------------------------------------------------------- decoding

Kind :: enum u8 {
	Alu,
	Branch,
	Jump,
	Call,
	Jr,
	Jalr,
	Bad,
	Sys,
}

// Registers an instruction reads or writes; HILO stands for hi and lo.
HILO :: 32
Regs :: bit_set[0 ..= 32;u64]

Insn :: struct {
	pc, w, target:              u32,
	op, rs, rt, rd, sa, fn, imm: u32,
	kind:                       Kind,
	reads, writes:              Regs,
	is_load:                    bool,
}

@(private = "file")
is_load_op :: proc(op: u32) -> bool {
	return op >= 0x20 && op <= 0x26
}

@(private = "file")
is_store_op :: proc(op: u32) -> bool {
	return op == 0x28 || op == 0x29 || op == 0x2a || op == 0x2b || op == 0x2e
}

@(private = "file")
decode :: proc(pc, w: u32) -> Insn {
	i := Insn {
		pc  = pc,
		w   = w,
		op  = w >> 26,
		rs  = w >> 21 & 31,
		rt  = w >> 16 & 31,
		rd  = w >> 11 & 31,
		sa  = w >> 6 & 31,
		fn  = w & 63,
		imm = w & 0xffff,
	}
	op, rs, rt, rd := i.op, i.rs, i.rt, i.rd
	switch {
	case op == 0:
		switch i.fn {
		case 0, 2, 3:
			i.reads, i.writes = {int(rt)}, {int(rd)}
		case 4, 6, 7:
			i.reads, i.writes = {int(rs), int(rt)}, {int(rd)}
		case 8:
			i.kind, i.reads = .Jr, {int(rs)}
		case 9:
			i.kind, i.reads, i.writes = .Jalr, {int(rs)}, {int(rd)}
		case 12, 13:
			i.kind = .Sys
		case 16, 18:
			i.reads, i.writes = {HILO}, {int(rd)}
		case 17, 19:
			i.reads, i.writes = {int(rs)}, {HILO}
		case 24, 25, 26, 27:
			i.reads, i.writes = {int(rs), int(rt)}, {HILO}
		case 32 ..= 39, 42, 43:
			i.reads, i.writes = {int(rs), int(rt)}, {int(rd)}
		case:
			i.kind = .Bad
		}
	case op == 1:
		if rt & 0x1e == 0x10 || rt == 0 || rt == 1 {
			i.kind, i.reads = .Branch, {int(rs)}
			i.target = pc + 4 + u32(sx16(i.imm) << 2)
			if rt & 0x1e == 0x10 {
				i.writes = {31}
			}
		} else {
			i.kind = .Bad
		}
	case op == 2 || op == 3:
		i.kind = op == 2 ? .Jump : .Call
		i.target = (pc + 4) & 0xf0000000 | (w & 0x3ffffff) << 2
		if op == 3 {
			i.writes = {31}
		}
	case op >= 4 && op <= 7:
		i.kind = .Branch
		i.reads = op <= 5 ? {int(rs), int(rt)} : {int(rs)}
		i.target = pc + 4 + u32(sx16(i.imm) << 2)
	case op >= 8 && op <= 14:
		i.reads, i.writes = {int(rs)}, {int(rt)}
	case op == 15:
		i.writes = {int(rt)}
	case op == 16:
		switch {
		case rs == 0:
			i.writes, i.is_load = {int(rt)}, true
		case rs == 4:
			i.reads = {int(rt)}
		case rs == 16 && i.fn == 16:
		case:
			i.kind = .Bad
		}
	case op == 18:
		switch {
		case rs == 0 || rs == 2:
			i.writes, i.is_load = {int(rt)}, true
		case rs == 4 || rs == 6:
			i.reads = {int(rt)}
		case rs & 16 != 0:
		case:
			i.kind = .Bad
		}
	case is_load_op(op):
		i.reads = {int(rs)}
		if op == 0x22 || op == 0x26 {
			i.reads += {int(rt)}
		}
		i.writes, i.is_load = {int(rt)}, true
	case is_store_op(op):
		i.reads = {int(rs), int(rt)}
	case op == 0x32 || op == 0x3a:
		i.reads = {int(rs)}
	case:
		i.kind = .Bad
	}
	i.reads -= {0}
	i.writes -= {0}
	return i
}

@(private = "file")
has_delay :: proc(i: Insn) -> bool {
	return i.kind == .Branch || i.kind == .Jump || i.kind == .Call || i.kind == .Jr || i.kind == .Jalr
}

// `break 1` after main: never returns.
@(private = "file")
is_break_1 :: proc(i: Insn) -> bool {
	return i.kind == .Sys && i.fn == 13 && i.w >> 6 & 0xfffff == 1
}

// ---------------------------------------------------------------- emission

@(private = "file")
R :: proc(n: u32) -> string {
	return n == 0 ? "0" : fmt.aprintf("c.r[%d]", n)
}

@(private = "file")
signed_hex :: proc(base: string, off: i32) -> string {
	return fmt.aprintf("%s %s 0x%x", base, off > 0 ? "+" : "-", abs(off))
}

@(private = "file")
addr_expr :: proc(i: Insn) -> string {
	off := sx16(i.imm)
	switch {
	case off == 0:
		return R(i.rs)
	case i.rs == 0:
		return hexu(u32(off))
	}
	return signed_hex(R(i.rs), off)
}

@(private = "file")
set_reg :: proc(rd: u32, expr: string, side_effect := false) -> []string {
	if rd == 0 {
		return side_effect ? slice.clone([]string{fmt.aprintf("_ = %s", expr)}) : nil
	}
	return slice.clone([]string{fmt.aprintf("c.r[%d] = %s", rd, expr)})
}

@(private = "file")
one :: proc(format: string, args: ..any) -> []string {
	return slice.clone([]string{fmt.aprintf(format, ..args)})
}

// Odin statements for a non-control-transfer instruction.
@(private = "file")
emit_op :: proc(i: Insn) -> []string {
	op, rs, rt, rd, sa := i.op, i.rs, i.rt, i.rd, i.sa
	f :: fmt.aprintf
	switch {
	case op == 0:
		switch i.fn {
		case 0:
			return sa != 0 ? set_reg(rd, f("%s << %d", R(rt), sa)) : set_reg(rd, R(rt))
		case 2:
			return set_reg(rd, f("%s >> %d", R(rt), sa))
		case 3:
			return set_reg(rd, f("u32(i32(%s) >> %d)", R(rt), sa))
		case 4:
			return set_reg(rd, f("%s << (%s & 31)", R(rt), R(rs)))
		case 6:
			return set_reg(rd, f("%s >> (%s & 31)", R(rt), R(rs)))
		case 7:
			return set_reg(rd, f("u32(i32(%s) >> (%s & 31))", R(rt), R(rs)))
		case 16:
			return set_reg(rd, "c.hi")
		case 17:
			return one("c.hi = %s", R(rs))
		case 18:
			return set_reg(rd, "c.lo")
		case 19:
			return one("c.lo = %s", R(rs))
		case 24:
			return one("psx.mult(%s, %s)", R(rs), R(rt))
		case 25:
			return one("psx.multu(%s, %s)", R(rs), R(rt))
		case 26:
			return one("psx.div(%s, %s)", R(rs), R(rt))
		case 27:
			return one("psx.divu(%s, %s)", R(rs), R(rt))
		case 32, 33, 37:
			switch {
			case rt == 0:
				return set_reg(rd, R(rs))
			case rs == 0:
				return set_reg(rd, R(rt))
			}
			return set_reg(rd, f("%s %s %s", R(rs), i.fn == 37 ? "|" : "+", R(rt)))
		case 34, 35:
			return set_reg(rd, f("%s - %s", R(rs), R(rt)))
		case 36:
			return set_reg(rd, f("%s & %s", R(rs), R(rt)))
		case 38:
			return set_reg(rd, f("%s ~ %s", R(rs), R(rt)))
		case 39:
			if rs == 0 && rt == 0 {
				return set_reg(rd, "0xffffffff") // ~ of an untyped 0 fails to build
			}
			return set_reg(rd, f("~(%s | %s)", R(rs), R(rt)))
		case 42:
			return set_reg(rd, f("i32(%s) < i32(%s) ? 1 : 0", R(rs), R(rt)))
		case 43:
			return set_reg(rd, f("%s < %s ? 1 : 0", R(rs), R(rt)))
		case 12:
			return one("psx.syscall(%s)", hexu(i.pc))
		case 13:
			return one("psx.brk(%s, 0x%x)", hexu(i.pc), i.w >> 6 & 0xfffff)
		}
	case op == 8 || op == 9:
		imm := sx16(i.imm)
		switch {
		case rs == 0:
			return set_reg(rt, hexu(u32(imm)))
		case imm == 0:
			return set_reg(rt, R(rs))
		}
		return set_reg(rt, signed_hex(R(rs), imm))
	case op == 10:
		return set_reg(rt, f("i32(%s) < %d ? 1 : 0", R(rs), sx16(i.imm)))
	case op == 11:
		return set_reg(rt, f("%s < %s ? 1 : 0", R(rs), hexu(u32(sx16(i.imm)))))
	case op == 12:
		return set_reg(rt, f("%s & 0x%x", R(rs), i.imm))
	case op == 13:
		if rs == 0 {
			return set_reg(rt, f("0x%x", i.imm))
		}
		return set_reg(rt, f("%s | 0x%x", R(rs), i.imm))
	case op == 14:
		return set_reg(rt, f("%s ~ 0x%x", R(rs), i.imm))
	case op == 15:
		return set_reg(rt, hexu(i.imm << 16))
	case op == 16:
		switch {
		case rs == 0:
			return set_reg(rt, f("psx.mfc0(%d)", rd), true)
		case rs == 4:
			return one("psx.mtc0(%d, %s)", rd, R(rt))
		case rs == 16 && i.fn == 16:
			return one("psx.rfe()")
		}
	case op == 18:
		switch {
		case rs == 0 || rs == 2:
			return set_reg(rt, f("psx.gte_read(%d)", rs == 0 ? rd : rd + 32), true)
		case rs == 4 || rs == 6:
			return one("psx.gte_write(%d, %s)", rs == 4 ? rd : rd + 32, R(rt))
		case rs & 16 != 0:
			return one("psx.gte_cmd(0x%x)", i.w & 0x1ffffff)
		}
	case is_load_op(op):
		a := addr_expr(i)
		switch op {
		case 0x22, 0x26:
			return set_reg(rt, f("psx.%s(%s, %s)", op == 0x22 ? "lwl" : "lwr", a, R(rt)), true)
		}
		names := [7]string{"lb", "lh", "", "lw", "lbu", "lhu", ""}
		return set_reg(rt, f("psx.%s(%s)", names[op - 0x20], a), true)
	case is_store_op(op):
		names := [7]string{"sb", "sh", "swl", "sw", "", "", "swr"}
		return one("psx.%s(%s, %s)", names[op - 0x28], addr_expr(i), R(rt))
	case op == 0x32:
		return one("psx.gte_write(%d, psx.lw(%s))", rt, addr_expr(i))
	case op == 0x3a:
		return one("psx.sw(%s, psx.gte_read(%d))", addr_expr(i), rt)
	}
	return one("psx.bad_insn(%s, %s)", hexu(i.pc), hexu(i.w))
}

@(private = "file")
branch_cond :: proc(i: Insn) -> string {
	switch i.op {
	case 4:
		if i.rs == i.rt {
			return "true"
		}
		return fmt.aprintf("%s == %s", R(i.rs), R(i.rt))
	case 5:
		return fmt.aprintf("%s != %s", R(i.rs), R(i.rt))
	case 6:
		return fmt.aprintf("i32(%s) <= 0", R(i.rs))
	case 7:
		return fmt.aprintf("i32(%s) > 0", R(i.rs))
	}
	// REGIMM
	if i.rt & 1 != 0 {
		return fmt.aprintf("i32(%s) >= 0", R(i.rs))
	}
	return fmt.aprintf("i32(%s) < 0", R(i.rs))
}

// ---------------------------------------------------------------- functions

Set :: map[u32]struct{}

Func :: struct {
	entry:    u32,
	start:    u32, // range start
	end:      u32, // exclusive range end
	insns:    map[u32]Insn, // reachable
	labels:   Set,
	delay:    Set, // delay-slot pcs
	exits:    Set, // branch/jump targets outside [start, end)
	warnings: [dynamic]string,
}

@(private = "file")
func_make :: proc(entry, end: u32, start: Maybe(u32) = nil) -> ^Func {
	f := new(Func)
	f.entry, f.end = entry, end
	f.start = start.? or_else entry
	f.labels[entry] = {}
	return f
}

@(private = "file")
inside :: #force_inline proc(f: ^Func, a: u32) -> bool {
	return f.start <= a && a < f.end
}

// The part of a sorted address list inside [lo, hi).
@(private = "file")
sorted_range :: proc(s: []u32, lo, hi: u32) -> []u32 {
	a, _ := slice.binary_search(s, lo)
	b, _ := slice.binary_search(s, hi)
	for a > 0 && s[a - 1] >= lo {
		a -= 1
	}
	for b > 0 && s[b - 1] >= hi {
		b -= 1
	}
	return s[a:max(a, b)]
}

// Walk reachable code of f inside [start, end). A computed `jr` (not `$ra`)
// with no code pointers into the function can land on any instruction, as
// in a Duff's device, so then every word in the range is walked and
// labelled. extra_labels is sorted.
@(private = "file")
discover :: proc(img: Code_Image, f: ^Func, extra_labels: []u32) {
	extra := sorted_range(extra_labels, f.start, f.end)
	work: [dynamic]u32
	append(&work, f.entry)
	append(&work, ..extra)
	for a in extra {
		f.labels[a] = {}
	}
	seen: Set
	defer delete(seen)
	walk(img, f, &work, &seen)
	computed := false
	for _, i in f.insns {
		computed ||= i.kind == .Jr && i.rs != 31
	}
	if computed && len(extra) == 0 {
		clear(&work)
		for a := f.start; a < f.end; a += 4 {
			if a not_in seen {
				append(&work, a)
			}
		}
		walk(img, f, &work, &seen)
		for a in f.insns {
			if a not_in f.delay {
				f.labels[a] = {}
			}
		}
	}
	delete(work)
	// A delay slot that is also a label needs its successor labelled too.
	// Ascending, so a chain of delay slots (data decoded as branches) is
	// labelled the same way on every run.
	for d in sorted_keys(f.delay) {
		if d in f.labels {
			f.labels[d + 4] = {}
		}
	}
}

// Decode reachable instructions from the pcs in work.
@(private = "file")
walk :: proc(img: Code_Image, f: ^Func, work: ^[dynamic]u32, seen: ^Set) {
	for len(work) > 0 {
		pc := pop(work)
		step: for {
			if !inside(f, pc) || pc in seen^ {
				break
			}
			w, ok := word(img, pc)
			if !ok {
				break
			}
			seen[pc] = {}
			i := decode(pc, w)
			f.insns[pc] = i
			if i.kind == .Bad {
				break
			}
			if has_delay(i) {
				d := pc + 4
				if inside(f, d) && d not_in f.insns {
					if dw, d_ok := word(img, d); d_ok {
						f.insns[d] = decode(d, dw)
						seen[d] = {}
					}
				}
				f.delay[d] = {}
				#partial switch i.kind {
				case .Branch, .Jump:
					if inside(f, i.target) {
						f.labels[i.target] = {}
						append(work, i.target)
					} else {
						f.exits[i.target] = {}
					}
					if i.kind == .Jump {
						break step
					}
					pc += 8
					continue step
				case .Call, .Jalr:
					pc += 8
					continue step
				}
				break step // jr
			}
			if is_break_1(i) {
				break
			}
			pc += 4
		}
		if pc == f.end {
			f.exits[pc] = {} // falls through into the next function
		}
	}
}

// Patch points: before the instruction at the address, when the Odin
// condition holds, go to the target (a label in the same function) instead.
// For changes inside a function that a whole-function hook cannot reach.
Patch :: struct {
	at:     u32,
	cond:   string,
	target: u32,
}

// Map tiles, models: a tile (or part) is skipped unless one of its projected
// corners lies on the screen, which drops near faces that span it with
// every corner off it. psx.tiles_unculled skips the test.
PATCHES :: [?]Patch {
	{0x80143B84, "psx.tiles_unculled", 0x80143C64}, // LAYER_SETUP floor
	{0x80144B5C, "psx.tiles_unculled", 0x80144C3C}, // MAP_DRAW
	{0x801464C8, "psx.tiles_unculled", 0x801465A8}, // MODEL_DRAW
	{0x80147D84, "psx.tiles_unculled", 0x80147E64}, // f_8014756c model faces
	{0x80148B34, "psx.tiles_unculled", 0x80148C14}, // f_8014829c model faces
	{0x801491EC, "psx.tiles_unculled", 0x801492CC}, // f_80148efc
}

// Per-block hook for BOF4_TRACE=block; one bit test when tracing is off.
@(private = "file")
trace_stmt :: proc(pc: u32) -> string {
	return fmt.aprintf("if .Block in psx.trace.active {{psx.trace_block(%s)}}", hexu(pc))
}

@(private = "file")
Emitter :: struct {
	f:         ^Func,
	out:       ^strings.Builder,
	body:      [dynamic]string,
	open_case: bool, // current case can fall into the next label
	pending:   int, // instructions not yet charged to c.cycles
}

@(private = "file")
em_flush :: proc(e: ^Emitter) {
	if e.pending != 0 {
		append(&e.body, fmt.aprintf("c.cycles += %d", e.pending * CYCLES_PER_INSN))
		e.pending = 0
	}
}

// Statements that transfer control to t from instruction src.
@(private = "file")
em_goto :: proc(e: ^Emitter, src, t: u32, indent := "") {
	if inside(e.f, t) && t in e.f.labels {
		append(&e.body, fmt.aprintf("%spc = %s", indent, hexu(t)))
		if t <= src {
			append(&e.body, concat(indent, "if c.cycles >= psx.next_event {psx.run_events()}"))
		}
		append(&e.body, concat(indent, "continue"))
		return
	}
	append(&e.body, fmt.aprintf("%spsx.call(%s)", indent, hexu(t)), concat(indent, "return"))
}

@(private = "file")
em_close_case :: proc(e: ^Emitter) {
	for s in e.body {
		strings.write_string(e.out, "\t\t\t")
		strings.write_string(e.out, s)
		strings.write_byte(e.out, '\n')
	}
	clear(&e.body)
}

@(private = "file")
line :: proc(b: ^strings.Builder, format: string, args: ..any) {
	if len(args) == 0 {
		strings.write_string(b, format)
	} else {
		fmt.sbprintf(b, format, ..args)
	}
	strings.write_byte(b, '\n')
}

@(private = "file")
emit_func :: proc(f: ^Func, out: ^strings.Builder, name: string) {
	line(out, "%s :: proc() {{", name)
	line(out, "\tc := &psx.cpu")
	line(out, "\tif c.cycles >= psx.next_event {psx.run_events()}")
	line(out, "\tpc: u32 = %s", hexu(f.entry))
	line(out, "\tfor {")
	line(out, "\t\tswitch pc {")
	pcs := make([]u32, len(f.insns))
	n := 0
	for pc in f.insns {
		pcs[n] = pc
		n += 1
	}
	slice.sort(pcs)
	e := Emitter {
		f   = f,
		out = out,
	}
	skip_delay: Set
	for idx := 0; idx < len(pcs); {
		pc := pcs[idx]
		idx += 1
		i := f.insns[pc]
		if pc in skip_delay {
			continue
		}
		if pc in f.labels {
			if e.open_case {
				em_flush(&e)
				append(&e.body, "fallthrough")
			}
			em_close_case(&e)
			line(out, "\t\tcase %s:", hexu(pc))
			append(&e.body, trace_stmt(pc))
			e.open_case = true
		} else if !e.open_case {
			// Unreachable by fallthrough and unlabelled: only a delay slot can get here.
			continue
		}
		for p in PATCHES {
			if p.at != pc {
				continue
			}
			if p.target not_in f.labels {
				append(&f.warnings, fmt.aprintf("patch target %s is not a label", hexu(p.target)))
			} else {
				em_flush(&e)
				append(&e.body, fmt.aprintf("if %s {{", p.cond))
				em_goto(&e, pc, p.target, "\t")
				append(&e.body, "}")
			}
		}
		e.pending += 1

		if i.kind == .Alu || i.kind == .Sys || i.kind == .Bad {
			// Load delay: the next instruction still sees the old register value.
			nxt, has_next := f.insns[pc + 4]
			if i.is_load && i.writes != {} && has_next && pc + 4 not_in f.labels && !has_delay(nxt) && pc + 4 not_in skip_delay {
				rt := 0
				for r in i.writes {
					rt = r
				}
				lwlr_pair := (i.op == 0x22 || i.op == 0x26) && (nxt.op == 0x22 || nxt.op == 0x26) && int(nxt.rt) == rt
				if (rt in nxt.reads || rt in nxt.writes) && !lwlr_pair {
					// The slot instruction reads the old value. If it also
					// writes rt, its write wins and the loaded value is lost
					// (the load still happens: I/O reads have side effects).
					stmts := emit_op(i)
					_, _, expr := strings.partition(stmts[0], " = ")
					append(&e.body, "{", concat("ld := ", expr))
					append(&e.body, ..emit_op(nxt))
					if rt in nxt.writes {
						append(&e.body, "_ = ld")
					} else {
						append(&e.body, fmt.aprintf("c.r[%d] = ld", rt))
					}
					append(&e.body, "}")
					e.pending += 1
					idx += 1
					continue
				}
			}
			if i.kind == .Bad {
				append(&e.body, fmt.aprintf("psx.bad_insn(%s, %s)", hexu(pc), hexu(i.w)))
				em_flush(&e)
				append(&e.body, "return")
				e.open_case = false
				continue
			}
			append(&e.body, ..emit_op(i))
			if is_break_1(i) {
				em_flush(&e)
				append(&e.body, "return")
				e.open_case = false
			}
			continue
		}

		// control transfer with delay slot
		d, has_d := f.insns[pc + 4]
		dstmts: []string
		if has_d {
			if has_delay(d) {
				append(&f.warnings, fmt.aprintf("branch in delay slot at %s", hexu(pc + 4)))
			} else {
				dstmts = emit_op(d)
				e.pending += 1
			}
		}
		skip_delay[pc + 4] = {}
		ret := pc + 8

		#partial switch i.kind {
		case .Branch:
			link := i.op == 1 && i.rt & 0x1e == 0x10
			cond := branch_cond(i)
			append(&e.body, "{", concat("t := ", cond))
			if link {
				append(&e.body, fmt.aprintf("c.r[31] = %s", hexu(ret)))
			}
			append(&e.body, ..dstmts)
			em_flush(&e)
			if link {
				append(&e.body, fmt.aprintf("if t {{psx.call(%s)}}", hexu(i.target)), "}")
			} else {
				append(&e.body, "if t {")
				em_goto(&e, pc, i.target, "\t")
				append(&e.body, "}", "}")
			}
			if cond == "true" && !link {
				e.open_case = false
			}
		case .Jump:
			append(&e.body, ..dstmts)
			em_flush(&e)
			em_goto(&e, pc, i.target)
			e.open_case = false
		case .Call:
			append(&e.body, fmt.aprintf("c.r[31] = %s", hexu(ret)))
			append(&e.body, ..dstmts)
			em_flush(&e)
			append(&e.body, fmt.aprintf("psx.call(%s)", hexu(i.target)))
		case .Jalr:
			append(&e.body, "{", fmt.aprintf("t: u32 = %s", R(i.rs)))
			if i.rd != 0 {
				append(&e.body, fmt.aprintf("c.r[%d] = %s", i.rd, hexu(ret)))
			}
			append(&e.body, ..dstmts)
			em_flush(&e)
			append(&e.body, "psx.call(t)", "}")
		case .Jr:
			if i.rs == 31 {
				append(&e.body, ..dstmts)
				em_flush(&e)
				append(&e.body, "return")
			} else {
				append(&e.body, "{", fmt.aprintf("t: u32 = %s", R(i.rs)))
				append(&e.body, ..dstmts)
				em_flush(&e)
				append(&e.body, "pc = t", "if c.cycles >= psx.next_event {psx.run_events()}", "continue", "}")
			}
			e.open_case = false
		}

		if pc + 4 in f.labels && has_d {
			// The delay slot is itself a jump target: give it its own case.
			if e.open_case {
				em_flush(&e)
				append(&e.body, fmt.aprintf("pc = %s", hexu(pc + 8)), "continue")
			}
			em_close_case(&e)
			line(out, "\t\tcase %s:", hexu(pc + 4))
			append(&e.body, trace_stmt(pc + 4))
			append(&e.body, ..dstmts)
			e.pending += 1
			e.open_case = true
		}
	}

	if e.open_case {
		em_flush(&e)
		append(&e.body, fmt.aprintf("psx.call(%s)", hexu(f.end)), "return")
	}
	em_close_case(&e)
	line(out, "\t\tcase:")
	line(out, "\t\t\tpsx.jump_unknown(%s, pc)", hexu(f.start))
	line(out, "\t\t\treturn")
	line(out, "\t\t}")
	line(out, "\t}")
	line(out, "}")
	line(out, "")
}

// ---------------------------------------------------------------- inputs

// The entries listed in funcs.tsv, by space ("ram" or an overlay's name).
@(private = "file")
load_funcs :: proc(path: string) -> map[string][dynamic]u32 {
	by_space: map[string][dynamic]u32
	for l in strings.split_lines(string(read_file(path))) {
		p := strings.split(l, "\t")
		if len(p) < 5 || p[0] == "space" {
			continue
		}
		list := by_space[p[0]]
		append(&list, parse_hex(p[1]))
		by_space[p[0]] = list
	}
	return by_space
}

// Aligned words anywhere in img that point into [lo, hi).
@(private = "file")
code_pointers :: proc(img: Code_Image, lo, hi: u32, out: ^Set) {
	for o := 0; o + 4 <= len(img.data); o += 4 {
		v := u32le(img.data, o)
		if lo <= v && v < hi && v & 3 == 0 {
			out[v] = {}
		}
	}
}

@(private = "file")
call_targets :: proc(img: Code_Image, lo, hi: u32) -> Set {
	out: Set
	for a := lo; a < hi; a += 4 {
		if w, ok := word(img, a); ok && w >> 26 == 3 {
			out[(a + 4) & 0xf0000000 | (w & 0x3ffffff) << 2] = {}
		}
	}
	return out
}

// True when the code before e (skipping up to four nop padding words) ends
// with an unconditional jump (jr, j, b) and its delay slot.
@(private = "file")
terminator_before :: proc(img: Code_Image, e: u32) -> bool {
	p := e - 4
	for _ in 0 ..< 4 {
		if w, ok := word(img, p); !ok || w != 0 {
			break
		}
		p -= 4
	}
	for q in ([2]u32{p, p - 4}) {
		if q > e - 8 {
			continue // e would be this instruction's delay slot
		}
		w, ok := word(img, q)
		if !ok {
			return true
		}
		i := decode(q, w)
		if i.kind == .Jr || i.kind == .Jump || w >> 16 == 0x1000 {
			return true
		}
	}
	return false
}

// Addresses in [lo, hi) built in code by `lui` + `addiu`/`ori` pairs, such
// as callbacks passed as arguments.
@(private = "file")
address_constants :: proc(img: Code_Image, lo, hi: u32, out: ^Set) {
	upper: [32]Maybe(u32)
	for o := 0; o + 4 <= len(img.data); o += 4 {
		w := u32le(img.data, o)
		op, rs, rt := w >> 26, w >> 21 & 31, w >> 16 & 31
		if op == 0x0f {
			upper[rt] = (w & 0xffff) << 16
		} else if h, ok := upper[rs].?; ok && (op == 0x09 || op == 0x0d) {
			v := h + (op == 0x0d ? w & 0xffff : u32(sx16(w)))
			if lo <= v && v < hi && v & 3 == 0 {
				out[v] = {}
			}
		}
	}
}

// Words a function may run before its `addiu $sp, $sp, -n` prologue: game
// code often loads a global first (`lui` + load) and tests it after.
MAX_PRE_PROLOGUE :: 3

@(private = "file")
is_prologue :: proc(img: Code_Image, a: u32) -> bool {
	w, ok := word(img, a)
	return ok && w >> 16 == 0x27bd && w & 0x8000 != 0
}

// True when [a, end) is `lui`s and loads based on registers those `lui`s
// set, starting with a `lui`: a load of a global. Data such as pointers into
// overlay space decodes as loads, but not based this way.
@(private = "file")
global_loads :: proc(img: Code_Image, a, end: u32) -> bool {
	upper: bit_set[0 ..< 32;u32]
	for q := a; q < end; q += 4 {
		w, ok := word(img, q)
		if !ok {
			return false
		}
		op, rs, rt := w >> 26, w >> 21 & 31, w >> 16 & 31
		if op == 0x0f {
			upper += {int(rt)}
		} else if !(op == 0x20 || op == 0x21 || op == 0x23 || op == 0x24 || op == 0x25) || int(rs) not_in upper {
			return false
		}
	}
	return upper != {}
}

// Start of the function whose prologue is at p: p, or the global loads of
// up to MAX_PRE_PROLOGUE words just before it.
@(private = "file")
function_start :: proc(img: Code_Image, p, lo: u32) -> u32 {
	for k := u32(MAX_PRE_PROLOGUE); k > 0; k -= 1 {
		a := p - 4 * k
		if a >= lo && global_loads(img, a, p) {
			return a
		}
	}
	return p
}

// Referenced code addresses that begin a function: a prologue, or the start
// of the global loads before one (function_start). Jump table targets do
// not, and splitting at one would turn a loop through it into recursion.
// Functions after a `jr $ra` are covered by return_boundaries.
@(private = "file")
pointer_entries :: proc(img: Code_Image, ptrs: []u32, lo: u32, out: ^Set) {
	for p in ptrs {
		for k in u32(0) ..= MAX_PRE_PROLOGUE {
			if is_prologue(img, p + 4 * k) {
				if k == 0 || function_start(img, p + 4 * k, lo) == p {
					out[p] = {}
				}
				break
			}
		}
	}
}

// The index of the first entry above t.
@(private = "file")
bisect_right :: proc(s: []u32, t: u32) -> int {
	lo, hi := 0, len(s)
	for lo < hi {
		mid := (lo + hi) / 2
		if t < s[mid] {
			hi = mid
		} else {
			lo = mid + 1
		}
	}
	return lo
}

@(private = "file")
any_call_or_stack :: proc(f: ^Func) -> (returns, calls: bool) {
	for _, i in f.insns {
		returns ||= i.kind == .Jr && i.rs == 31
		calls ||= i.kind == .Call || i.kind == .Jalr || 29 in (i.reads + i.writes)
	}
	return
}

// Functions for referenced code addresses without a prologue, which
// pointer_entries leaves to the preceding function: after an unconditional
// jump, code that returns through `jr $ra`, never leaves itself and never
// touches the stack or makes a call: a leaf function. A jump-table case can
// look the same, but such leaves are also called through function-pointer
// tables (`jalr`), so each gets a function of just its own code, overlapping
// its container, where it stays a label. Cases that end in their function's
// epilogue restore $sp, so they are left out.
@(private = "file")
pointer_leaves :: proc(img: Code_Image, ptrs: []u32, entries: []u32, hi: u32, out: ^[dynamic]^Func) {
	for p in ptrs {
		if !terminator_before(img, p) {
			continue
		}
		n := bisect_right(entries, p)
		f := func_make(p, n < len(entries) ? entries[n] : hi)
		discover(img, f, nil)
		returns, calls := any_call_or_stack(f)
		if len(f.exits) == 0 && returns && !calls {
			append(out, f)
		}
	}
}

// First non-nop word after each `jr $ra` and its delay slot: where the next
// function usually starts.
@(private = "file")
return_boundaries :: proc(img: Code_Image, lo, hi: u32, out: ^Set) {
	for q := lo; q + 8 < hi; q += 4 {
		if w, _ := word(img, q); w != 0x03e00008 {
			continue
		}
		a := q + 8
		for a < hi {
			if w, ok := word(img, a); !ok || w != 0 {
				break
			}
			a += 4
		}
		if a < hi {
			out[a] = {}
		}
	}
}

@(private = "file")
sorted_keys :: proc(s: Set) -> []u32 {
	out := make([]u32, len(s))
	n := 0
	for k in s {
		out[n] = k
		n += 1
	}
	slice.sort(out)
	return out
}

@(private = "file")
union_sorted :: proc(a: []u32, b: Set) -> []u32 {
	s: Set
	defer delete(s)
	for k in a {
		s[k] = {}
	}
	for k in b {
		s[k] = {}
	}
	return sorted_keys(s)
}

@(private = "file")
split_module :: proc(img: Code_Image, hi: u32, entries: []u32, extra_labels: []u32) -> [dynamic]^Func {
	funcs: [dynamic]^Func
	for e, n in entries {
		f := func_make(e, n + 1 < len(entries) ? entries[n + 1] : hi)
		discover(img, f, extra_labels)
		append(&funcs, f)
	}
	return funcs
}

// Split [lo, hi) at the entries. An entry the preceding function branches
// past is mid-function and is dropped, unless it is in fixed (`jal`
// targets); it stays a label and gets a secondary function. A branch that
// still leaves its function for a non-entry address (code shared between
// functions) becomes a tail call, so each such target also gets a secondary
// function entered there and covering its container's whole range, so loops
// back across the target stay inside it. Secondary functions overlap their
// container instead of splitting it. Addresses in leaf_ptrs that
// pointer_leaves accepts get one too.
@(private = "file")
build_module :: proc(img: Code_Image, lo, hi: u32, all_entries: Set, extra_labels: Set, fixed: Set, leaf_ptrs: Set) -> []^Func {
	entries: [dynamic]u32
	for e in sorted_keys(all_entries) {
		if lo <= e && e < hi {
			append(&entries, e)
		}
	}
	extra := sorted_keys(extra_labels)
	dropped: Set
	funcs: [dynamic]^Func
	for {
		funcs = split_module(img, hi, entries[:], union_sorted(extra, dropped))
		inner: Set
		for n in 0 ..< len(funcs) - 1 {
			nxt := funcs[n + 1]
			if nxt.entry in fixed {
				continue
			}
			for t in funcs[n].exits {
				if nxt.entry < t && t < nxt.end {
					inner[nxt.entry] = {}
					break
				}
			}
		}
		if len(inner) == 0 {
			break
		}
		for e in inner {
			dropped[e] = {}
		}
		kept: [dynamic]u32
		for e in entries {
			if e not_in inner {
				append(&kept, e)
			}
		}
		entries = kept
	}
	labels := union_sorted(extra, dropped)
	known: Set
	for e in entries {
		known[e] = {}
	}
	work: [dynamic]u32
	for e in dropped {
		append(&work, e)
	}
	for f in funcs {
		for t in f.exits {
			append(&work, t)
		}
	}
	for len(work) > 0 {
		t := pop(&work)
		if t in known || !(lo <= t && t < hi) || t & 3 != 0 {
			continue
		}
		known[t] = {}
		n := bisect_right(entries[:], t)
		g := func_make(t, n < len(entries) ? entries[n] : hi, n > 0 ? entries[n - 1] : lo)
		discover(img, g, labels)
		append(&funcs, g)
		for x in g.exits {
			append(&work, x)
		}
	}
	leaves: [dynamic]u32
	for p in leaf_ptrs {
		if lo <= p && p < hi && p not_in known {
			append(&leaves, p)
		}
	}
	pointer_leaves(img, leaves[:], entries[:], hi, &funcs)
	slice.stable_sort_by(funcs[:], proc(a, b: ^Func) -> bool {return a.entry < b.entry})
	return funcs[:]
}

// Identity of a function's code: overlays often share identical copies.
@(private = "file")
func_key :: proc(f: ^Func) -> string {
	ctx: sha1.Context
	sha1.init(&ctx)
	pcs := make([]u32, len(f.insns))
	defer delete(pcs)
	n := 0
	for pc in f.insns {
		pcs[n] = pc
		n += 1
	}
	slice.sort(pcs)
	for pc in pcs {
		pair: [8]u8
		put_u32(pair[:], 0, pc)
		put_u32(pair[:], 4, f.insns[pc].w)
		sha1.update(&ctx, pair[:])
	}
	// The Python tool's repr((start, end, sorted(labels))).
	b := strings.builder_make()
	fmt.sbprintf(&b, "(%d, %d, [", f.start, f.end)
	for l, k in sorted_keys(f.labels) {
		fmt.sbprintf(&b, k == 0 ? "%d" : ", %d", l)
	}
	strings.write_string(&b, "])")
	sha1.update(&ctx, b.buf[:])
	digest: [sha1.DIGEST_SIZE]u8
	sha1.final(&ctx, digest[:])
	return fmt.aprintf("f_%08x_%s", f.entry, hex_string(digest[:])[:8])
}

@(private = "file")
load_exe :: proc(path: string) -> Code_Image {
	raw := read_file(path)
	text, size := u32le(raw, 0x18), int(u32le(raw, 0x1c))
	return {text, raw[0x800:min(0x800 + size, len(raw))]}
}

@(private = "file")
Overlay :: struct {
	name: string,
	img:  Code_Image,
}

// Every overlay in the manifest.
@(private = "file")
overlay_images :: proc(dir: string) -> []Overlay {
	out: [dynamic]Overlay
	for r in manifest_rows(dir) {
		append(&out, Overlay{strings.trim_suffix(r[0], ".bin"), {parse_hex(r[1]), read_file(join(dir, r[0]))}})
	}
	return out[:]
}

// Code addresses referenced anywhere: data words and lui/addiu pairs in the
// executable and all overlays, since overlays call each other and the
// executable through pointers.
@(private = "file")
program_refs :: proc(exe: Code_Image, overlays: []Overlay) -> Set {
	out: Set
	code_pointers(exe, RAM_LO, RAM_HI, &out)
	address_constants(exe, RAM_LO, RAM_HI, &out)
	for o in overlays {
		code_pointers(o.img, RAM_LO, RAM_HI, &out)
		address_constants(o.img, RAM_LO, RAM_HI, &out)
	}
	return out
}

// Entries of the code in [lo, hi) and the jal targets among them. Entries
// in known are certain and skip the plausibility check; listed entries that
// ordinary code falls through into are dropped (Ghidra places some
// mid-function), but `jal` targets are always kept.
@(private = "file")
module_entries :: proc(img: Code_Image, lo, hi: u32, listed: []u32, refs: Set, known: Set) -> (entries, calls: Set) {
	calls = call_targets(img, lo, hi)
	for e in listed {
		if e in calls || terminator_before(img, e) {
			entries[e] = {}
		}
	}
	for e in known {
		entries[e] = {}
	}
	inside: [dynamic]u32
	for a in refs {
		if lo <= a && a < hi {
			append(&inside, a)
		}
	}
	pointer_entries(img, inside[:], lo, &entries)
	return_boundaries(img, lo, hi, &entries)
	for e in calls {
		entries[e] = {}
	}
	return
}

@(private = "file")
Package :: struct {
	name: string,
	body: strings.Builder,
	rows: [dynamic]string,
	deps: map[string]struct{},
}

@(private = "file")
warn :: proc(f: ^Func, quiet: bool) {
	if !quiet {
		for w in f.warnings {
			fmt.eprintfln("warning %s: %s", hexu(f.entry), w)
		}
	}
}

// Recompile the executable into <out dir>/exe.odin.
recomp_exe :: proc(exe_path, ovl_dir, funcs_path, out_dir: string, quiet := false) {
	img := load_exe(exe_path)
	spaces := load_funcs(funcs_path)
	refs := program_refs(img, overlay_images(ovl_dir))
	ptrs: Set
	code_pointers(img, EXE_CODE_LO, EXE_CODE_HI, &ptrs)
	entries, calls := module_entries(img, EXE_CODE_LO, EXE_CODE_HI, spaces["ram"][:], refs, {})
	funcs := build_module(img, EXE_CODE_LO, EXE_CODE_HI, entries, ptrs, calls, refs)
	b := strings.builder_make()
	line(&b, "%s\npackage rec\n\nimport \"../psx\"\n", REC_HEADER)
	names := make([]string, len(funcs))
	n := 0
	for f, k in funcs {
		names[k] = fmt.aprintf("f_%08x", f.entry)
		emit_func(f, &b, names[k])
		warn(f, quiet)
		n += len(f.insns)
	}
	line(&b, "EXE_FUNCS := [?]psx.Func_Entry{")
	for f, k in funcs {
		line(&b, "\t{{%s, %s}},", hexu(f.entry), names[k])
	}
	line(&b, "}")
	make_dirs(out_dir)
	write_file(join(out_dir, "exe.odin"), b.buf[:])
	print("exe: %d functions, %d instructions", len(funcs), n)
}

// Instructions per generated overlay package. Odin compiles packages as
// separate LLVM modules (-use-separate-modules), so smaller packages build
// in parallel.
OVL_PACKAGE_INSNS :: 50000

// Recompile every overlay; identical functions are emitted once.
recomp_overlays :: proc(exe_path, ovl_dir, funcs_path, out_dir: string, quiet := false) {
	spaces := load_funcs(funcs_path)
	overlays := overlay_images(ovl_dir)
	refs := program_refs(load_exe(exe_path), overlays)
	packages: [dynamic]^Package
	Emitted :: struct {
		pkg, name: string,
	}
	emitted: map[string]Emitted
	cur: ^Package
	size := OVL_PACKAGE_INSNS
	total := 0
	for o in overlays {
		img := o.img
		slot, hi := img.base, img.base + u32(len(img.data))
		ov_id, _ := word(img, slot)
		ptrs: Set
		code_pointers(img, slot, hi, &ptrs)
		// Code may follow a header of strings or tables; its first function
		// can be reached only through pointers built at run time. Header
		// data precedes it, so it skips the fall-through check.
		known: Set
		for a := slot + 4; a < hi; a += 4 {
			if is_prologue(img, a) {
				known[function_start(img, a, slot + 4)] = {}
				break
			}
		}
		entries, calls := module_entries(img, slot + 4, hi, spaces[o.name][:], refs, known)
		for k in known {
			calls[k] = {}
		}
		funcs := build_module(img, slot + 4, hi, entries, ptrs, calls, refs)
		if size >= OVL_PACKAGE_INSNS {
			cur = new(Package)
			cur.name = fmt.aprintf("ovl_%02d", len(packages))
			append(&packages, cur)
			size = 0
		}
		for f in funcs {
			key := func_key(f)
			if key not_in emitted {
				emit_func(f, &cur.body, key)
				warn(f, quiet)
				emitted[key] = {cur.name, key}
				size += len(f.insns)
				total += len(f.insns)
			}
			e := emitted[key]
			ref := e.name
			if e.pkg != cur.name {
				ref = fmt.aprintf("%s.%s", e.pkg, e.name)
				cur.deps[e.pkg] = {}
			}
			sig: [4]string
			for &s, k in sig {
				w, _ := word(img, f.entry + 4 * u32(k))
				s = hexu(w)
			}
			append(&cur.rows, fmt.aprintf("\t{{%s, %s, %s, {{%s}}, %s}},", hexu(f.entry), hexu(slot), hexu(ov_id), strings.join(sig[:], ", "), ref))
		}
	}
	for p in packages {
		dir := join(out_dir, p.name)
		make_dirs(dir)
		b := strings.builder_make()
		line(&b, "%s\npackage %s\n\nimport \"../../psx\"", REC_HEADER, p.name)
		deps := make([]string, len(p.deps))
		n := 0
		for d in p.deps {
			deps[n] = d
			n += 1
		}
		slice.sort(deps)
		for d in deps {
			line(&b, "import \"../%s\"", d)
		}
		if len(deps) > 0 {
			line(&b, "")
		}
		line(&b, "")
		strings.write_string(&b, strings.to_string(p.body))
		line(&b, "FUNCS := [?]psx.Ovl_Entry{")
		for r in p.rows {
			line(&b, "%s", r)
		}
		line(&b, "}")
		write_file(join(dir, "funcs.odin"), b.buf[:])
	}
	b := strings.builder_make()
	line(&b, "%s\npackage rec\n\nimport \"../psx\"", REC_HEADER)
	for p in packages {
		line(&b, "import \"%s\"", p.name)
	}
	line(&b, "\nregister_overlays :: proc() {")
	for p in packages {
		line(&b, "\tpsx.register_overlay_funcs(%s.FUNCS[:])", p.name)
	}
	line(&b, "}")
	write_file(join(out_dir, "overlays.odin"), b.buf[:])
	print("overlays: %d packages, %d unique functions, %d instructions", len(packages), len(emitted), total)
}

recomp_main :: proc(args: []string) {
	usage(args, RECOMP_USAGE, 5)
	switch args[0] {
	case "exe":
		recomp_exe(args[1], args[2], args[3], args[4])
	case "ovl":
		recomp_overlays(args[1], args[2], args[3], args[4])
	case:
		fail("%s", RECOMP_USAGE)
	}
}

