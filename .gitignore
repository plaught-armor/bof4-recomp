# Only the port, its tools and the notes are tracked. The disc image, what is
# extracted or generated from it (disc/, overlays/, port/src/rec/), the Ghidra
# project, saves, builds and debug output stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/setup.sh
!/setup.bat
!/docs/
!/tools/
!/tests/
/tests/local/
!/port/
/port/*
!/port/build.sh
!/port/build.bat
!/port/src/
/port/src/rec/
/tools/bof4tools
/tools/bof4tools.exe
__pycache__/
# ps-recomp checkout (a submodule later); here a link to a local one.
/ps-recomp
